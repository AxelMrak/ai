{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai/skills/sources.schema.json",
  "title": "Skills Sources Registry",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "$schema": { "type": "string" },
    "_comment": { "type": "string" },
    "_note": { "type": "string" },
    "registry": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string" },
        "source_of_truth": { "type": "string" },
        "generated_index": { "type": "string" }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "cleanup": { "type": "boolean" },
        "trusted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["repo", "path", "branch"],
        "properties": {
          "repo": { "type": "string", "minLength": 3 },
          "path": { "type": "string", "minLength": 1 },
          "branch": { "type": "string", "minLength": 1 },
          "pinned_ref": { "type": "string", "minLength": 7 },
          "trusted": { "type": "boolean" },
          "cleanup": { "type": "boolean" },
          "last_verified": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "preserve": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "bulk_sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["repo", "path", "branch", "sync_method"],
        "properties": {
          "repo": { "type": "string" },
          "path": { "type": "string" },
          "branch": { "type": "string" },
          "sync_method": { "type": "string" },
          "last_synced": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "skills_count": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
